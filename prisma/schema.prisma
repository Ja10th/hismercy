generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  price         Int
  description   String?
  inStock       Boolean @default(true)
  stockCount    Int     @default(0)
  featured      Boolean @default(false)
  featuredOrder Int     @default(999)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  images ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Order {
  id        String @id @default(cuid())
  orderCode String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  fullName String
  email    String
  phone    String
  street   String
  city     String
  state    String
  landmark String?
  notes    String?

  deliveryMethod String
  subtotal       Int
  deliveryFee    Int
  total          Int
  status         String @default("pending")

  paymentStatus    String    @default("pending")
  paymentReference String?   @unique
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([email])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  name      String
  price     Int
  qty       Int
  image     String

  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  @@index([expiresAt])
  @@index([userId])
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  phone     String
  street    String
  city      String
  state     String
  landmark  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([phone])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([status])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  category    String?
  coverImage  String?
  status      String   @default("draft") // draft | scheduled | published
  scheduledAt DateTime?
  publishedAt DateTime?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model AdminNotification {
  id          String   @id @default(cuid())
  title       String
  description String
  href        String?
  type        String   @default("system") // order | blog | product | customer | brand | system
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([read, createdAt])
  @@index([type])
}

model PaymentAuditLog {
  id              String   @id @default(cuid())
  provider        String   @default("paystack")
  event           String
  dedupeKey       String   @unique
  reference       String?
  transactionId   Int?
  orderId         String?
  rawBody         String
  signatureVerified Boolean @default(false)
  status          String   @default("received") // received | ignored | processed | failed
  errorMessage    String?
  createdAt       DateTime @default(now())
  processedAt     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([provider, event])
  @@index([reference])
  @@index([transactionId])
  @@index([status])
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String
  label       String
  description String?
  value       Json
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model AuditLog {
  id         String   @id @default(cuid())
  // Who performed the action (admin email/name, or "system")
  actor      String
  // Category: order | product | brand | blog | customer | settings | auth | payment | system
  category   String
  // Human-readable past-tense action: "Updated order status", "Deleted product", etc.
  action     String
  // The entity being acted on (order code, product name, etc.)
  target     String?
  // Optional link back to the entity in the admin
  href       String?
  // JSON snapshot of changed fields or relevant metadata
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([category])
  @@index([actor])
  @@index([createdAt])
}